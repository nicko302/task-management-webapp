@using Microsoft.EntityFrameworkCore
@inject CRUD_Application.Data.ApplicationDbContext _context

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRUD_Application</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>
<body>
    <header>
        <hr class="headerLine">

        <nav>
            @* ------- header bar *@
            <div class="headerBar">
                <div class="headerTitle" onclick="EditBoardName(this)" id="@Model.Id"><h1>@ViewData["BoardName"]</h1></div>
                <div class="headerDot">•</div>
                <div class="headerDesc" onclick="EditBoardDesc(this)" id="@Model.Id">@ViewData["BoardDesc"]</div>
                <div class="headerDelete" onclick="DeleteBoard(this)" id="@Model.Id"><b>🗑</b></div>

                <div class="userIcon">
                    <svg width="34px" height="34px" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff">
                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                        <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                        <g id="SVGRepo_iconCarrier">
                            <path d="M8 7C9.65685 7 11 5.65685 11 4C11 2.34315 9.65685 1 8 1C6.34315 1 5 2.34315 5 4C5 5.65685 6.34315 7 8 7Z" fill="#ffffff"></path>
                            <path d="M14 12C14 10.3431 12.6569 9 11 9H5C3.34315 9 2 10.3431 2 12V15H14V12Z" fill="#ffffff"></path>
                        </g>
                    </svg>
                </div>

            </div>
                
            @* ------- side bar *@
            <button class="sidebarToggle" onclick="toggleSidebar()">☰</button>
            <div class="overlay" id="overlay">
                <div class="sidebar sidebarHidden" id="sidebar">
                
                    <button class="closeSidebar" onclick="toggleSidebar()">«</button>
                    <li class="sidebarTitle">
                        <p style="margin-top: 16px; margin-bottom: 15px;">My boards</p>
                    </li>

                    <ul class="user-boards-list">
                        @*----- display all boards in the sidebar, belonging to the current user*@
                        @{
						    var userId = 1; /////////////// replace with actual user ID retrieval logic

						    // fetch boards belonging to the current user
                            var boardsOfUser = _context.UserHasBoard
                               .Include(uhb => uhb.Board)
                               .Where(uhb => uhb.UserId == userId && uhb.Board.AdminId == null)
                               .OrderBy(uhb => uhb.Position)
                               .ToList();
                    
                            foreach (var board in boardsOfUser)
                            {
                                <li>
                                    <a class="sidebarButton my-board-button"
                                        data-board-id="@board.BoardId"
                                        asp-controller="Boards"
                                        asp-action="Index"
                                        asp-route-id="@board.BoardId">
                                        @board.Board.Name
                                    </a>

                                    <span class="sidebarBoardOptions" onclick="OpenBoardOptions(this, @board.BoardId, '@board.Board.Name', '@board.Board.Desc')"><b>&nbsp⋮&nbsp&nbsp</b></span>
                                    <div class="sidebarUpDownDiv">
                                        <span class="sidebarUp" onclick="MoveBoard(@board.BoardId, 'up')">⏶</span>
                                        <span class="sidebarDown" onclick="MoveBoard(@board.BoardId, 'down')">⏷</span>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                    
                    <li>
                        <span class="sidebarNewBoard" onclick="NewBoard(this)">
                            <b>+</b> &nbspNew board
                        </span>
                    </li>
                    
                    <br />
                    <hr class="sidebarLine">
                    <li class="sidebarTitle">
                        <br>
                        <p style="margin-top: -10px; margin-bottom: 15px;">Shared boards</p>
                    </li>

                    <ul class="shared-boards-list">
                        @*----- display all shared boards in the sidebar that the user is part of*@
                        @{
                            // fetch boards belonging to the current user
                            var sharedBoardsOfUser = _context.UserHasBoard
                               .Include(uhb => uhb.Board)
                               .Where(uhb => uhb.UserId == userId && uhb.Board.AdminId != null)
                               .OrderBy(uhb => uhb.Position)
                               .ToList();
                    
                            foreach (var uhb in sharedBoardsOfUser)
                            {
                                <li>
                                    <a class="sidebarButton shared-board-button"
                                           data-board-id="@uhb.BoardId"
                                           asp-controller="Boards"
                                           asp-action="Index"
                                           asp-route-id="@uhb.BoardId">
                                        @uhb.Board.Name
                                    </a>

                                    <span class="sidebarBoardOptions shared" onclick="OpenBoardOptions(this, @uhb.BoardId, '@uhb.Board.Name', '@uhb.Board.Desc')"><b>&nbsp⋮&nbsp&nbsp</b></span>
                                    <div class="sidebarUpDownDiv">
                                        <span class="sidebarUp" onclick="MoveBoard(@uhb.BoardId, 'up')">⏶</span>
                                        <span class="sidebarDown" onclick="MoveBoard(@uhb.BoardId, 'down')">⏷</span>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                    <li>
                        <span class="sidebarNewBoard" onclick="JoinSharedBoard(this)">
                            <b>➥</b> &nbspJoin board
                        </span>
                    </li>
                    <li>
                        <span class="sidebarNewBoard" onclick="NewSharedBoard(this)">
                            <b>+</b> &nbspNew board
                        </span>
                    </li>

                </div>
            </div>
        </nav>

    </header>

    <div class="main">
        <main role="main">
            @RenderBody()
        </main>
    </div>



    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CRUD_Application - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
