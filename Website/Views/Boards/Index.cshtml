@model CRUD_Application.Models.Board
@{
	Layout = "_Layout";
}

@if (Model == null)
{
	<h2>Please select a board from the sidebar.</h2>
}
else
{
	ViewData["Title"] = Model.Name;
	ViewData["BoardName"] = Model.Name;
	ViewData["BoardDesc"] = Model.Desc;

	<div class="lists-row" data-board-id="@Model.Id">

		@foreach (var list in Model.Lists)
		{
			<div class="list-column" style="background-color: @list.HexColour;" data-colour-hex="@list.HexColour" data-colour-text="@list.Colour">

				<span class="list-name" id="@list.Id" onclick="EditList(this)">@list.Name</span>

				<div class="list-options-icons" id="@list.Id">
					<span class="colour-list" onclick="EditListColour(this)" id="@list.Id">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
							 viewBox="0 0 16 16"
							 style="stroke: currentColor; stroke-width: 0.8px; stroke-linejoin: round;">
							<path d="M8 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3m4 3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M5.5 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3" />
							<path d="M16 8c0 3.15-1.866 2.585-3.567 2.07C11.42 9.763 10.465 9.473 10 10c-.603.683-.475 1.819-.351 2.92C9.826 14.495 9.996 16 8 16a8 8 0 1 1 8-8m-8 7c.611 0 .654-.171.655-.176.078-.146.124-.464.07-1.119-.014-.168-.037-.37-.061-.591-.052-.464-.112-1.005-.118-1.462-.01-.707.083-1.61.704-2.314.369-.417.845-.578 1.272-.618.404-.038.812.026 1.16.104.343.077.702.186 1.025.284l.028.008c.346.105.658.199.953.266.653.148.904.083.991.024C14.717 9.38 15 9.161 15 8a7 7 0 1 0-7 7" />
						</svg>
					</span>

					<span class="move-list-left" onclick="MoveList(this, 'left')" id="@list.Id">⏴</span>
					<span class="move-list-right" onclick="MoveList(this, 'right')" id="@list.Id">⏵</span>

					<span class="delete-list" onclick="DeleteListConfirmation(this)" id="@list.Id"><b>✕</b></span>
				</div>


				<ul id="@list.Id" class="task-ul">
					@foreach (var task in list.Tasks)
					{
						@* display tasks in the list *@
						<li style="list-style: none; position: relative;" id="@list.Id" class="task-li">

							<span class="down" onclick="MoveTask(this, 'down')" id="@task.Id">⏷</span>
							<span class="up" onclick="MoveTask(this, 'up')" id="@task.Id">⏶</span>

							<label class="container @(task.Completed == 1 ? "completed-task" : "task")" id="label_@task.Id" data-task-pos=@task.Position>
								@task.Content
								<input type="checkbox"
									data-task-id="@task.Id"
									onchange="toggleCheckbox(this)"
									class="task-checkbox"
									@(task.Completed == 1 ? "checked" : "")> @* checks in database if task has been completed *@
								<span class="checkmark"></span>
							</label>

							<div class="edit-delete-span">
								<span class="edit" onclick="EditTask(this)" id="@task.Id">✎</span>
								<span class="delete" onclick="DeleteTask(this)" id="@task.Id" data-task-pos=@task.Position>✕</span>
							</div>
						</li>
					}

					@* new task button *@
					<li style="list-style: none">
						<label class="container"></label>
						<button class="newTask" onclick="NewTask(this)">+</button>

					</li>
				</ul>
			</div>
		}

		<span class="new-list" onclick="NewList(this)" data-board-id="@Model.Id."><b>+</b></span>

	</div>
}