@model CRUD_Application.Models.Board
@{
	Layout = "_Layout";
}

@if (Model == null)
{
	<h2>Please select a board from the sidebar.</h2>
}
else
{
	ViewData["Title"] = Model.Name;
	ViewData["BoardName"] = Model.Name;
	ViewData["BoardDesc"] = Model.Desc;

	<div class="lists-row" data-board-id="@Model.Id">

		@foreach (var list in Model.Lists)
		{
			<div class="list-column" style="background-color: @list.HexColour;" data-colour-hex="@list.HexColour" data-colour-text="@list.Colour">

				<span class="list-name" id="label_@list.Id">@list.Name</span>
				<div class="edit-delete-list" id="@list.Id">
					<span class="edit-list" onclick="EditList(this)" id="@list.Id">✎</span>
					<span class="delete-list" onclick="DeleteList(this)" id="@list.Id">🗑</span>
				</div>

				<ul id="@list.Id">
					@foreach (var task in list.Tasks)
					{
						@* display tasks in the list *@
						<li style="list-style: none; position: relative;" id="@list.Id">

							<label class="container @(task.Completed == 1 ? "completed-task" : "task")" id="label_@task.Id">
								@task.Content
								<input type="checkbox"
									data-task-id="@task.Id"
									onchange="toggleCheckbox(this)"
									class="task-checkbox"
									@(task.Completed == 1 ? "checked" : "")> @* checks in database if task has been completed *@
								<span class="checkmark"></span>
							</label>

							<div class="edit-delete-span">
								<span class="edit" onclick="EditTask(this)" id="@task.Id">✎</span>
								<span class="delete" onclick="DeleteTask(this)" id="@task.Id">🗑</span>
							</div>
						</li>
					}

					@* new task button *@
					<li style="list-style: none">
						<label class="container"></label>
						<button class="newTask" onclick="NewTask(this)">+</button>

					</li>
				</ul>
			</div>
		}

		<span class="new-list" onclick="NewList(this)" data-board-id="@Model.Id.">+</span>

	</div>
}

@section Scripts {
	<script src="~/js/functions.js" asp-append-version="true"></script>
}