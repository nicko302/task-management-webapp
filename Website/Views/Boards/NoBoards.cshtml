@{
    ViewData["Title"] = "No Boards Found";
}

<div class="no-boards-div">

    <span class="login-logo" style="margin-top: -30px;">☒</span>
    @if (User.Identity.IsAuthenticated)
    {
        <h1>You don't have any boards yet!</h1>
        <p style="font-size: 20px;">Create your first board to start organizing your tasks.</p>

        <button class="login-button" onclick="NewBoard()">
            + Create My First Board
        </button>
    }
    else
    {
        <h1>You aren't logged in!</h1>
        <p style="font-size: 20px;">Log in or register to begin your <b>asc</b>ent.</p>

        <button class="login-button" onclick="toggleUserInfo()">
            Open account panel
        </button>
    }

</div>
