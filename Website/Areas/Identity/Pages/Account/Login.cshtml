@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="login-container" style="height: 100vh;">
    <div class="login-panel">
        <span class="login-logo">☑︎</span>
        <h1>tAsc</h1>
        <h3><b>Asc</b>end your workflow.</h3>
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div>
                    <input asp-for="Input.UserName" class="login-form" autocomplete="username" aria-required="true" placeholder="username" />
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>
                <div style="margin-top: 30px;">
                <input asp-for="Input.Password" class="login-form" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div style="margin-top: 30px;">
                    <label asp-for="Input.RememberMe" class="login-label">
                        <input class="login-checkbox" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                <button id="login-submit" type="submit" class="login-button">Log in</button>
                </div>
                <div>
                    <hr style="margin-top: 50px; margin-bottom: 50px; opacity: 0.1;"/>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    </p>
                    <p style="margin-bottom: 60px;">
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                    </p>
                </div>
            </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
